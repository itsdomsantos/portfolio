# Copy this file to .env.local and fill in the values.
# (.env.local is git-ignored, so your secrets stay out of the repo.)

# Required — your Resend API key. Get one free at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — where contact-form submissions are delivered.
# Defaults to domingosjsmsantos@gmail.com if not set.
CONTACT_TO=domingosjsmsantos@gmail.com

# Optional — the "from" address shown on the email.
# In Resend test mode, keep onboarding@resend.dev (it delivers to the
# email you registered your Resend account with).
# After verifying your own domain in Resend, use e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM=Portfolio <onboarding@resend.dev>
